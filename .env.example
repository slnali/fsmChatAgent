# Copy to .env (task setup does this) and add your Anthropic API key.
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5
GRADER_MODEL=claude-sonnet-5-5

# Local docker compose Postgres, one DSN per role.
OWNER_DATABASE_URL=postgresql://fsm_owner:fsm_owner_local@localhost:5432/fsm
AGENT_RO_DATABASE_URL=postgresql://fsm_agent_ro:agent_ro_local@localhost:5432/fsm
APP_DATABASE_URL=postgresql://fsm_app:app_local@localhost:5432/fsm

# Role passwords, set by migration 004_roles.sql (must match the DSNs above).
FSM_AGENT_RO_PASSWORD=agent_ro_local
FSM_APP_PASSWORD=app_local

# Relative to this folder.
DATA_DB_PATH=data/data.db.gz
MAX_RESULT_ROWS=20

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
